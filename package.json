{
  "name": "jmeter-performance-test-runner",
  "version": "0.1.0",
  "description": "Electron GUI for running JMeter tests with customizable parameters and progress tracking",
  "main": "src/main.js",
  "homepage": "./",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --mac --win",
    "dist": "npm run build:all",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "jmeter",
    "performance",
    "testing",
    "gui"
  ],
  "author": "TheDarkNight",
  "license": "MIT",
  "devDependencies": {
    "electron": "39.8.5",
    "electron-builder": "26.6.0"
  },
  "dependencies": {
    "capture-jmeter-report": "file:../capture-jmeter-report/capture-jmeter-report-0.1.0.tgz",
    "electron-store": "^8.1.0"
  },
  "overrides": {
    "undici": "7.24.0"
  },
  "build": {
    "appId": "com.thedarknight.jmeter-performance-test-runner",
    "productName": "JMeter Performance Test Runner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "JMeter Performance Test Runner",
      "background": "assets/dmg-background.png",
      "icon": "assets/icon.icns",
      "iconSize": 100,
      "contents": [
        {
          "x": 750,
          "y": 415,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 352,
          "y": 415,
          "type": "file"
        }
      ],
      "window": {
        "width": 1080,
        "height": 760
      }
    }
  }
}
